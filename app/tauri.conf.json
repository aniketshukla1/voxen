{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Team",
  "version": "0.1.0",
  "identifier": "com.voicebots.team",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Voice Team",
        "width": 1080,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
