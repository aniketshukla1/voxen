# Copy to .env and paste your keys. .env is gitignored: never commit it.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Brains: add a key for any provider you want. Each bot picks one in its Change voice dialog.
# xAI's key also gives every bot X search and Grok Imagine pictures.
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
# Any other OpenAI-compatible server: its address, and a key if it needs one
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
# Ollama and LM Studio run on this Mac and need no key (OLLAMA_BASE_URL moves Ollama).

